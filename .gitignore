# ───────────────────────────────
# Dependencies
# ───────────────────────────────
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# ───────────────────────────────
# Next.js build output & cache
# ───────────────────────────────
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ───────────────────────────────
# Production / misc
# ───────────────────────────────
/coverage
.turbo

# ───────────────────────────────
# Environment variables (never commit secrets)
# ───────────────────────────────
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# ───────────────────────────────
# Logs
# ───────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ───────────────────────────────
# Editor / IDE
# ───────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/

# ───────────────────────────────
# OS junk
# ───────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ───────────────────────────────
# Notes
# ───────────────────────────────
# Generated responsive image variants live in /public/assets/opt and are
# rebuilt by `npm run images` (also on `prebuild`). They are kept in the repo
# so local dev is instant. To stop tracking them instead, uncomment:
# /public/assets/opt/
